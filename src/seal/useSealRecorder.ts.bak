// 印章录入（一次性）
// 1. 计算所有触点的几何中心
// 2. 记录每个点到中心点的距离
// 3. 排序 + 归一化
// 4. 和旋转方向无关
// 注意：需要保存这个fingerprint(JSON)
import type { TouchPoint, SealFingerprint } from './types'

export function recordSeal(points: TouchPoint[]): SealFingerprint | null {
  if (points.length < 3) return null

  const cx = points.reduce((s, p) => s + p.x, 0) / points.length
  const cy = points.reduce((s, p) => s + p.y, 0) / points.length

  const distances = points.map(p =>
    Math.hypot(p.x - cx, p.y - cy)
  )

  const max = Math.max(...distances)

  return {
    pointCount: points.length,
    distances: distances
      .map(d => d / max) // 归一化
      .sort((a, b) => a - b)
  }
}
