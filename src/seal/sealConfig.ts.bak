// 配置参数集中管理


export const sealConfig = {
  // 触控采集相关（设备差异）
  touch: {
    maxPoints: 5,
    endDelay: 600 // 触点更容易丢，延长
  },
  // 印章识别容错（现场环境）
  recognition: {
    diffThreshold: 0.15,  // 越小越严格（容易误触就调小）
    stableDuration: 300  // ms，触点稳定多久才算盖章
  },
  // 调试/展会模式开关：测试全置为true，正式环境，全置为false
  debug: {
    showTouchPoints: false,
    log: false
  }
}
