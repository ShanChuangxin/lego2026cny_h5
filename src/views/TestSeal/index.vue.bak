<script setup lang="ts">
import {sealConfig} from '@/seal/sealCofig'
const containerRef = ref()

const { activeTouchPoints } =
  useTouchSystem(containerRef)

const fingerprint = /* 你录入并保存的印章 */

const {
  isSealed,
  sealCenter,
  checkSeal
} = useSealRecognizer(activeTouchPoints, fingerprint, sealConfig)

watch(activeTouchPoints, checkSeal, { deep: true })
</script>

<template>
  <div ref="containerRef" class="touch-area">
    <img
      v-if="isSealed"
      src="/seal.png"
      class="seal"
      :style="{
        left: sealCenter.x + 'px',
        top: sealCenter.y + 'px'
      }"
    />
  </div>
</template>
